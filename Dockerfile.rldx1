# syntax=docker/dockerfile:1.7
#
# Build context: this Docker bundle directory.
# Target platform: linux/arm64 on DGX Spark / GB10.
#
# This Dockerfile intentionally does not COPY checkpoints, datasets, RoboCasa
# assets, logs, or videos. Mount those at runtime.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.05-py3
FROM --platform=linux/arm64 ${BASE_IMAGE}

ARG INSTALL_FLASH_ATTN=0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    TOKENIZERS_PARALLELISM=false \
    NO_ALBUMENTATIONS_UPDATE=1 \
    TORCH_COMPILE_DISABLE=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    PYTORCH_NVFUSER_DISABLE=1 \
    RLDX_ATTN_IMPL=sdpa \
    RLDX_DISABLE_CUDA_JIT_REDUCTIONS=1 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    FLASH_ATTN_CUDA_ARCHS=120

RUN apt-get update && apt-get install -y --no-install-recommends \
      git git-lfs curl wget ca-certificates \
      build-essential cmake ninja-build pkg-config patchelf \
    ffmpeg libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
      libegl1 libegl1-mesa-dev libgl1 libglvnd0 libgles2 libosmesa6 \
      libx11-6 libxext6 libxrender1 libsm6 libglib2.0-0 libglfw3 \
      libhdf5-dev libxml2-dev libxslt1-dev libusb-1.0-0 libhidapi-hidraw0 \
      python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/venvs/rldx/lib/python3.10/site-packages/torch/lib:${LD_LIBRARY_PATH}"

WORKDIR /opt

# Model-server env. RLDX pyproject is Python 3.10-only. On DGX Spark, prefer
# the NGC CUDA stack and source-build arm64/native extensions only when needed.
RUN uv venv --seed --python 3.10 /opt/venvs/rldx && \
    . /opt/venvs/rldx/bin/activate && \
    python -m pip install --upgrade pip setuptools wheel packaging && \
    pip install \
      "torch==2.7.0" "torchvision==0.22.0" \
      --extra-index-url https://download.pytorch.org/whl/cu128 && \
    pip install \
      "albumentations==1.4.18" "av==15.0.0" "diffusers==0.35.1" \
      "dm-tree==0.1.8" "lmdb==1.7.5" "msgpack==1.1.0" \
      "msgpack-numpy==0.4.8" "pandas==2.2.3" "peft==0.17.1" \
      "termcolor==3.2.0" "transformers==4.57.0" "tyro==0.9.17" \
      "click==8.1.8" "datasets==3.6.0" "einops==0.8.1" \
      "gymnasium==1.2.2" "matplotlib==3.10.1" "numpy==1.26.4" \
      "omegaconf==2.3.0" "scipy==1.15.3" \
      "wandb==0.23.0" "pyzmq==27.0.1" "deepspeed==0.17.6" \
      "moviepy==1.0.3" "opencv-contrib-python-headless==4.11.0.86" \
      "accelerate>=0.34" "safetensors>=0.4.5" "huggingface-hub>=0.26" \
      "Pillow>=10.0" "tqdm>=4.66" "requests>=2.32" "PyYAML>=6.0" \
      "websockets>=13.0" && \
    git clone --depth 1 --branch v0.4.0 https://github.com/pytorch/torchcodec.git /tmp/torchcodec && \
    sed -i '/cmake_args = \[/a\            *os.environ.get("CMAKE_ARGS", "").split(),' /tmp/torchcodec/setup.py && \
    sed -i '/find_package(Torch REQUIRED)/i\if(NOT TARGET CUDA::nvToolsExt)\n  add_library(CUDA::nvToolsExt INTERFACE IMPORTED)\nendif()' /tmp/torchcodec/src/torchcodec/_core/CMakeLists.txt && \
    ENABLE_CUDA=0 \
    CMAKE_ARGS="-DPython3_EXECUTABLE=$(command -v python) -DPython3_INCLUDE_DIR=$(python -c 'import sysconfig; print(sysconfig.get_path("include"))') -DPython3_LIBRARY=$(python -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR") + "/" + sysconfig.get_config_var("LDLIBRARY"))')" \
    I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 pip install --no-build-isolation /tmp/torchcodec && \
    if [ "${INSTALL_FLASH_ATTN}" = "1" ]; then \
      FLASH_ATTENTION_FORCE_BUILD=TRUE pip install \
        "git+https://github.com/Dao-AILab/flash-attention.git@v2.8.3" \
        --no-build-isolation; \
    fi

# RoboCasa365 rollout-client env. Keep it separate from model deps because
# RoboCasa365 pins numpy/mujoco differently from RLDX.
RUN uv venv --seed --python 3.10 /opt/venvs/robocasa365 && \
    . /opt/venvs/robocasa365/bin/activate && \
    python -m pip install --upgrade pip setuptools wheel && \
    unset PIP_CONSTRAINT && \
    pip install "numpy==2.2.5" "numba==0.61.2" "scipy==1.15.3" \
      "mujoco==3.3.1" "robosuite>=1.5.0" "gymnasium>=1.2.0" \
      pygame Pillow opencv-python-headless pyyaml tqdm termcolor imageio h5py lxml \
      hidapi "tianshou==0.4.10" "pyzmq==27.0.1" "msgpack==1.1.0" \
      "msgpack-numpy==0.4.8" "pandas>=2.2" "albumentations==1.4.18"

ENV RLDX_PYTHON=/opt/venvs/rldx/bin/python \
    PY365=/opt/venvs/robocasa365/bin/python \
    PYTHONPATH=/opt/rldx1:/opt/robocasa365_src:/opt/robosuite_src:${PYTHONPATH} \
    HF_HOME=/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/cache/huggingface/hub \
    TRANSFORMERS_CACHE=/cache/huggingface/hub

WORKDIR /opt/rldx1
VOLUME ["/checkpoints", "/datasets", "/assets", "/logs", "/videos", "/cache"]

CMD ["/bin/bash"]
